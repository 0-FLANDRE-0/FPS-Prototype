{
  "name": "fps-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Independent 3D CQB/FPS prototype with frozen 2D reference and v69 baseline",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-training.mjs",
    "dev": "node scripts/dev-training.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:training": "npm run build",
    "dev:training": "npm run dev",
    "test:training": "node --test tests/training*.test.mjs",
    "verify:reference": "node reference/2d/tools/verify-baseline.mjs",
    "verify:v69": "node scripts/verify-v69.mjs",
    "test:browser": "node scripts/check-migration-browser.mjs",
    "package": "python3 scripts/package-release.py",
    "verify:preserved": "node scripts/verify-preserved.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.25.10",
    "eslint-scope": "9.1.2",
    "playwright": "1.62.1",
    "sharp": "0.34.5"
  }
}
