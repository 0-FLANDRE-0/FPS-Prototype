  "entries": [
    {
      "id": "protected",
      "classification": [
        "원본"
      ],
      "rule": "2D/탄도/관통/방호/HP/상처통로/기존 생리 수식·자산 그대로",
      "reversePortCandidate": false,
      "automatic2DPort": false
    },
    {
      "id": "state",
      "classification": [
        "사용자 설계값"
      ],
      "rule": "의료 상태에 lazy appliedTreatments; 매 틱 B1 읽기; 같은 요청 함수; 본인만",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "flow",
      "classification": [
        "원본",
        "튜닝"
      ],
      "rule": "기존 raw orifice/closure/perfusion 계산 뒤 병변 계수; 제어된 합에 기존 CO/가용혈액 cap 식. 원래 병변면적 가중치 보존",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "external-only",
      "classification": [
        "원본",
        "사용자 설계값"
      ],
      "rule": "압박붕대: M2 실제 외부 성분만. 거즈: 검증된 열린 사지 통로 병변 자체를 줄인 뒤 M2 그대로 분배; 몸통은 복합 ooze의 외부 성분만. 직접 체강 혈관/장기 계수1. CAT은 체강/접합부 source 제외 원위 사지만. source.destination/pool은 기존 호환 분류.",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "cat-location",
      "classification": [
        "출처",
        "튜닝"
      ],
      "rule": "TCCC high&tight/2–3in proximal;65mm 선택. 원래24본 바인드 체인 투영/길이; world y 무관. 정확한 상처 위는 실제 상처 선택 필수, 부위만 선택하면 high&tight",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "cat-time",
      "classification": [
        "출처",
        "튜닝"
      ],
      "rule": "다리37.5초=Beaven2018 허벅지 자가 적용 중앙값. 팔28초·한 손1.65는 튜닝; 정확한 대응 시간 미확인",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "cat-effect",
      "classification": [
        "튜닝",
        "사용자 설계값",
        "게임 허용"
      ],
      "rule": "완료는 성공적 완전 조임, 잔여0.00005; 미완료 동맥1+.35p/정맥1-.85p. 연구92%는 별도 확률로 이식하지 않음",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "cat-function-pain",
      "classification": [
        "사용자 설계값",
        "튜닝",
        "게임 허용"
      ],
      "rule": "감은 사지 기능0/통증70 오버레이; HP·장시간 허혈 손상 없음. 제거 후 원래 상처 기능 계산/통증 감쇠",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "bandage",
      "classification": [
        "튜닝"
      ],
      "rule": "30초; 동맥.8/정맥.15/삼출.1. 중단은 완성 효과의45%×진도",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "gauze",
      "classification": [
        "출처",
        "튜닝"
      ],
      "rule": "채우기30초 튜닝 + 제조사 압박180초. 배율≥1. 압박 중 외부.15, 완료 동맥.03/정맥.05/삼출.1; 중단1-.25p. 붕대 계수와 곱",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "timing",
      "classification": [
        "사용자 설계값",
        "튜닝"
      ],
      "rule": "시작/재개 시 기능·통증·D1진폭·의식·관류 배율 고정; 한 팔 분쇄/절단이면 한 손, 둘이면 불가. 의식 소실 불가; 재개 준비1.5초",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "transactions",
      "classification": [
        "사용자 설계값",
        "게임 허용"
      ],
      "rule": "사용 중 전용 owner; 거즈/붕대 즉시개봉 소모/제거폐기. CAT 원래 자가컨테이너/가방 회수; 빈칸 없으면 제거 거부/효과 유지",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "ifak",
      "classification": [
        "사용자 설계값",
        "게임 허용",
        "출처"
      ],
      "rule": "CAT2개,3x3 9칸 추상화, 외부2x2. 실제 크기 비례 아님. 제품 무게는M2+CAT1개;483.602g",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "input",
      "classification": [
        "사용자 설계값",
        "튜닝"
      ],
      "rule": "치료 중 양손 잠금/시선자유/총기가림; hit(방호구 포함)/move/sprint/weapon/cancel중단. 치료는 화면닫아도 계속, 기존pause에서는 정지",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "pointer-lock",
      "classification": [
        "사용자 설계값"
      ],
      "rule": "신뢰된 닫기 버튼·키 입력 안 동기요청. Esc제외, 실패 후 다음좌클릭 재시도만 수행; 터치/펜 제외",
      "reversePortCandidate": false,
      "automatic2DPort": false
    },
    {
      "id": "debug-junction",
      "classification": [
        "게임 허용"
      ],
      "rule": "9mm35m/s 실제 traceShot/record로 경부 접합부 시험, 현실 탄속 아님",
      "reversePortCandidate": false,
      "automatic2DPort": false
    },
    {
      "id": "conscious-down-live-care",
      "classification": [
        "튜닝",
        "게임 허용"
      ],
      "rule": "실제 플레이에서 대퇴동맥 출혈은 완성 전 저혈압으로 쓰러질 수 있다. 진행 중 처치가 있으면 down상태에서도 기존 fixed-step 세계를 계속 돌린다. NPC는 기존대로 쓰러진 플레이어를 사격하지 않는다. 중단/완료되면 기존 down정지로 돌아간다. 정지 메뉴는 항상 정지. HUD는 down화면 위에 표시. 의료/래그돌 수식 그대로.",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "observed-increase",
      "classification": [
        "튜닝"
      ],
      "rule": "실제 제어 source유량이 같은 현재 혈역학/구멍의 계수1 유량보다1e-9mL/s 이상 크면 열린 상처에 더 많이 흐름을 표시. 생리 계산에 역입력 없음.",
      "reversePortCandidate": true,
      "automatic2DPort": false
    },
    {
      "id": "sector-ownership",
      "classification": [
        "튜닝",
        "게임 허용"
      ],
      "rule": "기존 구역 이동은 환자 인스턴스를 폐기한다. in-use 의료 물품이 있으면 구역 이동 전에 차단하고 제거/전체초기화를 안내해 복제/분실을 방지한다. 일반 무처치 이동은 기존대로.",
      "reversePortCandidate": true,
      "automatic2DPort": false
    }
  ],
