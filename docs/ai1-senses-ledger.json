    {
      "key": "perception-and-underlead",
      "classification": "튜닝",
      "values": {
        "gaussian": "existing LCG Box-Muller; clamp +/-3sigma; same sample reused between sight updates",
        "positionSigma": "skill.perceptionM*(1+d/20)*(1+.2*visibleSpeed)/sqrt(max(.1,exposure))*style*(1+3*suppression)",
        "verticalSigmaRatio": 0.65,
        "lead": "visibleVelocity * distance / muzzleVelocity * (.25+.6*composure)"
      },
      "notes": "Noise is an uncertain perceived point moved through the physical aiming motor, never a post-shot bullet cone. Underlead coefficient has no direct rifle experimental calibration.",
      "2D 역이식 후보": true
    },
    {
      "key": "fitts-motor",
