    {
      "key": "detection",
      "classification": "튜닝",
      "values": {
        "rate": "5 * exposure^1.35 * clamp(7/d,.25,2) * (1-.7*(ecc/(pi/3))^1.5) * (1+min(1,visibleSpeed/3)) * (crouched?.75:1) * D1visionDetection",
        "emptyDecayPerS": 0.45,
        "visibleSpeedCapMps": 8,
        "memoryDecayPerS": 0.08
      },
      "notes": "Movement estimated from successive clear samples of same part. Peripheral limitation research gives direction, not coefficients. Lighting uniform; prone target unavailable in current controls.",
      "2D 역이식 후보": true
    },
